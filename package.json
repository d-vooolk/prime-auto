{
  "name": "prime-auto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "restart": "rm -rf .next && NODE_ENV=production npm run build && sudo rm -rf /var/cache/nginx/* && sudo systemctl restart nginx && pm2 stop prime-auto && pm2 delete prime-auto && pm2 start ecosystem.config.cjs --env production",
    "deploy": "git pull && npm install && npm run restart"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@next/third-parties": "^16.0.7",
    "antd": "^5.22.6",
    "imask": "^7.6.1",
    "next": "^16.0.7",
    "nodemailer": "^6.9.16",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-imask": "^7.6.1",
    "react-input-mask-next": "^3.0.0-alpha.12",
    "sass": "^1.83.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "3.4.2",
    "typescript": "^5.7.2"
  }
}
