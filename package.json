{
  "name": "prime-auto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "restart": "rm -rf .next && NODE_ENV=production npm run build && pm2 startOrReload ecosystem.config.cjs --env production --update-env && sudo rm -rf /var/cache/nginx/* && sudo systemctl reload nginx",
    "deploy": "git pull && npm ci && npm run restart",
    "deploy:bluegreen": "bash scripts/deploy.sh",
    "rollback": "bash scripts/rollback.sh"
  },
  "dependencies": {
    "imask": "^7.6.1",
    "next": "^16.3.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "3.4.2",
    "typescript": "^5.7.2"
  }
}
